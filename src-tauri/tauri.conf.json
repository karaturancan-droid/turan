{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZirveFlow İşletme Yönetimi",
  "version": "0.1.0",
  "identifier": "com.zirveflow.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../.next"
  },
  "app": {
    "windows": [
      {
        "title": "ZirveFlow İşletme Yönetimi",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "appimage", "deb"],
    "createUpdaterArtifacts": false
  }
}
